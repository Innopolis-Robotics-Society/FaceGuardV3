@startuml deployment-view
skinparam componentStyle rectangle

node "Client device" as ClientDevice {
  component "Web browser" as Browser
  node "Optional browser camera" as ClientCamera
  ClientCamera --> Browser : getUserMedia\n(browser mode)
}

node "Raspberry Pi 5" as Pi {
  node "Docker Engine / Compose" {
    component "frontend service\nReact preview :3000" as Frontend
    component "backend service\nFastAPI/InsightFace :8000" as Backend
    database "db service\nPostgreSQL 15 :5432 internal" as Database
    cloud "faceguard bridge network" as Network
    Frontend -- Network
    Backend -- Network
    Database -- Network
  }

  node "V4L2 camera\nUSB or explicitly V4L2-exposed Pi camera" as Camera
  node "GPIO LEDs\nBCM 17/27/22" as GPIO
  folder "docker/insightface_models\nbind mount" as Models
  database "pgdata named volume" as PgData
  file "backend/.env\nservice environment source" as Env

  Camera --> Backend : /dev/videoN mapping\nPi override only
  GPIO --> Backend : /dev/gpiochipN mapping\nPi override only
  Models --> Backend : /root/.insightface/models
  PgData --> Database : /var/lib/postgresql/data
  Env ..> Backend
}

Browser --> Frontend : HTTP(S) :3000
Browser --> Backend : REST + WebSocket :8000
Backend --> Database : TCP 5432 on bridge only

note right of Database
  Base development Compose may expose 5432.
  The Pi override resets that host port.
end note

note bottom of Pi
  No door/motor controller is implemented.
  Normal CI has no camera or GPIO device mappings.
end note
@enduml
