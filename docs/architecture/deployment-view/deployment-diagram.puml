@startuml deployment-view
skinparam componentStyle rectangle
skinparam node {
    BackgroundColor white
    BorderColor black
}

node "Admin Workstation" <<Physical Device>> as PC {
    component "Web Browser" as Browser
}

node "Raspberry Pi (Edge Device)" <<Lab Entrance>> as RPi {
    node "Camera" <<Hardware (USB/CSI)>> as Cam
    node "LEDs & Door Relay" <<Hardware (GPIO)>> as DoorCtrl

    node "Docker Engine" as Docker {
        component "docker-frontend:latest" <<Docker Container>> as FrontendApp {
            artifact "React SPA (Vite)"
        }
        component "docker-backend:latest" <<Docker Container>> as BackendApp {
            artifact "FastAPI Server"
            artifact "InsightFace Model"
        }
        component "docker-db-1:latest" <<Docker Container>> as DB {
            artifact "PostgreSQL"
        }
    }
    
    folder "Local Storage" as Storage {
        folder "backend" as BackendDir {
            file ".env" as EnvFile
        }
        folder "insightface_models" as Models
        folder "pgdata" as PgData <<Docker Volume>>
    }
    
    BackendApp ..> EnvFile : " Mounts"
    BackendApp ..> Models : " Mounts"
    DB ..> PgData : " Mounts"
    FrontendApp ..> BackendDir : " Mounts (Source Code)"
    
    ' Physical connections inside the Pi
    Browser --> Cam : " Uses WebRTC (via Frontend UI)"
    BackendApp --> DoorCtrl : " Controls via GPIO"
}

' Network Connections
Browser --> FrontendApp : " HTTP :3000 (React UI)"
Browser --> BackendApp : " HTTP/WS :8000 (API & Video Stream)"
BackendApp --> DB : " TCP/IP :5432 (Internal Docker Network)"

@enduml
