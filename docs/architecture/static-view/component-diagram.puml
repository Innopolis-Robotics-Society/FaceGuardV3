@startuml static-view
skinparam componentStyle rectangle

actor Administrator
actor Person

package "React SPA" {
  component "Authentication and employee UI" as UI
  component "CameraContext" as CameraContext
  component "CameraPreview / bbox projection" as Preview
  component "Browser camera adapter\n(one JPEG in flight)" as BrowserCamera
}

package "FastAPI backend" {
  component "REST API" as Rest
  component "Authenticated WebSockets" as WS
  component "Operation lock" as Lock
  component "LatestFrameCamera\n(single capture, replace-only buffer)" as LatestCamera
  component "Recognition/enrollment orchestrator" as Orchestrator
  component "FaceProviderInterface" as Provider
  component "InsightFace provider" as InsightFace
  component "MiniFASNet liveness detector" as Liveness
  component "Employee/log data access" as DataAccess
  component "Generation-safe LED control" as LEDs
}

database "PostgreSQL 15" as PostgreSQL
component "V4L2 camera" as V4L2
component "GPIO LEDs\nBCM 17/27/22" as GPIO

Administrator --> UI
Person --> BrowserCamera
Person --> V4L2
UI --> Rest : HTTPS/JSON + Bearer JWT
CameraContext --> WS : WSS + JWT subprotocol
BrowserCamera --> CameraContext : browser mode JPEG
CameraContext --> Preview : exact response frame + bbox + dimensions
WS --> Lock
Lock --> Orchestrator
LatestCamera --> Orchestrator : backend mode latest frame
V4L2 --> LatestCamera : OpenCV VideoCapture
Orchestrator --> Provider
Provider <|.. InsightFace
InsightFace --> Liveness
Orchestrator --> DataAccess
DataAccess --> PostgreSQL : psycopg2 pool / SQL
Orchestrator --> LEDs
LEDs --> GPIO : gpiozero + LGPIOFactory

note right of Lock
  Recognition and enrollment
  cannot run concurrently.
end note

note bottom of GPIO
  Optional: application continues
  with GPIO_AVAILABLE=false.
end note
@enduml
