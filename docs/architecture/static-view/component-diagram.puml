@startuml static-view
skinparam componentStyle rectangle

actor Admin
actor Employee

package "Lab Entrance (Edge)" {
    component "Camera" as Cam
    component "LED Controller" as LEDCtrl <<Planned>>
}

package "Web Application Layer" {
    component "React Frontend" as Frontend <<Web UI (Vite/Node)>>
    component "FastAPI Backend" as Backend <<API & Logic Orchestrator>>
}

package "ML & Processing Subsystem" {
    component "Face Recognition Module" as FaceRec <<InsightFace>>
}

package "Local Database Container" {
    database "PostgreSQL" as DB
}

' Interfaces
interface "Video Stream (WebRTC)" as IVideo
interface "REST / WebSockets" as IAPI
interface "SQL Interface" as ISQL
interface "Hardware Control" as IHW

' Actor interactions
Admin --> Frontend : Uses (Web UI)
Employee --> Cam : Looks at

' Connections
Cam - IVideo
Frontend -( IVideo : " Requires (Browser)"

Frontend - IAPI
Backend -( IAPI : " Serves"

DB - ISQL
Backend -( ISQL : " Requires (psycopg2)"
    
LEDCtrl - IHW
Backend -( IHW : " Requires (Commands)"

interface "Internal Python Interface" as IFace

' Internal components
FaceRec - IFace
Backend -( IFace : " Requires"

@enduml
