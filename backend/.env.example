# Database credentials
DB_HOST=db
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=faceguard

# Admin panel credentials. Docker Compose treats '$' as interpolation, so
# bcrypt dollar signs must be doubled. The generator prints the escaped value.
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=replace-with-the-generated-bcrypt-hash

# Generate independently with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=INFO

# Explicit comma-separated browser allow-list; wildcard origins are rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser mode captures on the client. Backend mode owns CAMERA_INDEX through
# one OpenCV latest-frame worker. The Pi override maps CAMERA_DEVICE to it.
CAMERA_SOURCE=browser
CAMERA_DEVICE=/dev/video0
CAMERA_INDEX=0
OPERATION_HANDOFF_TIMEOUT_SECONDS=5.0

# Raspberry Pi GPIO configuration. Host device and container-visible chip
# number must refer to the same gpiochip.
GPIO_CHIP_DEVICE=/dev/gpiochip0
GPIO_CHIP=0

LIVENESS_MODEL_PATH=/root/.insightface/models/minifasnet.onnx

# Optional Vite build arguments consumed by Docker Compose. Empty values use
# the browser hostname and backend port 8000.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
