# Database Credentials
DB_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=faceguard

# Admin Panel Credentials
ADMIN_LOGIN=admin
# Docker Compose treats '$' as interpolation, so bcrypt dollar signs must be
# doubled. backend/scripts/generate_hash.py prints the correctly escaped value.
ADMIN_PASSWORD_HASH=replace-with-the-generated-bcrypt-hash

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=INFO

# Allowed browser origins for direct (non-SSH-forwarded) access. Keep this an
# explicit comma-separated allow-list; wildcard origins are rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Camera mode. The Raspberry Pi Compose override enforces backend/0; use
# browser here for laptop development where getUserMedia supplies frames.
CAMERA_SOURCE=browser
CAMERA_INDEX=0

# Allow an old WebSocket enough time to release camera/inference ownership
# when the UI switches directly between recognition and enrollment.
OPERATION_HANDOFF_TIMEOUT_SECONDS=5.0
