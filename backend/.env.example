# Database Credentials
DB_HOST=db
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=faceguard

# Admin Panel Credentials
ADMIN_LOGIN=admin
# Generate with backend/scripts/generate_hash.py; keep the emitted $$ escaping.
ADMIN_PASSWORD_HASH=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Browser mode captures on the client. Backend mode uses CAMERA_INDEX via OpenCV.
CAMERA_SOURCE=browser
CAMERA_INDEX=0
# Compose host-device path used by docker-compose.pi.yml.
CAMERA_DEVICE=/dev/video0
OPERATION_HANDOFF_TIMEOUT_SECONDS=5.0

# Raspberry Pi GPIO configuration (container-visible gpiochip number).
GPIO_CHIP=0
GPIO_CHIP_DEVICE=/dev/gpiochip0

# Explicit trusted frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LIVENESS_MODEL_PATH=/root/.insightface/models/minifasnet.onnx

# Optional Vite build arguments consumed by Docker Compose.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
