# Vite reads this value while building the SPA.
# Use browser for local development. docker-compose.pi.yml builds with backend.
VITE_CAMERA_SOURCE=browser

# Optional overrides. By default the SPA uses the page hostname, port 8000,
# and selects http/https plus ws/wss from the page protocol.
# VITE_API_BASE_URL=http://faceguard-pi.local:8000
# VITE_WS_BASE_URL=ws://faceguard-pi.local:8000
